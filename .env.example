# ═══════════════════════════════════════════════════════════════════════════
# JANSETU — Production Environment Variables
# Copy this file to .env and fill in every value marked "CHANGE_ME".
# Never commit .env to version control — it is in .gitignore.
# ═══════════════════════════════════════════════════════════════════════════

# ── MongoDB ─────────────────────────────────────────────────────────────────
# Credentials for the containerised MongoDB service
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_strong_mongo_password

# Motor connection string used by the backend
# If using the built-in mongodb container:
MONGO_URL=mongodb://admin:CHANGE_ME_strong_mongo_password@mongodb:27017/jansetu?authSource=admin
# If connecting to MongoDB already running on the host:
# MONGO_URL=mongodb://jansetu_user:PASSWORD@127.0.0.1:27017/jansetu?authSource=jansetu

DB_NAME=jansetu

# ── Authentication ───────────────────────────────────────────────────────────
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=CHANGE_ME_at_least_64_char_random_string
SESSION_SECRET=CHANGE_ME_another_long_random_string

# JWT token lifetime (seconds). Default 86400 = 24 h.
# ACCESS_TOKEN_EXPIRE_SECONDS=86400

# ── File Storage ─────────────────────────────────────────────────────────────
# Option A — local filesystem (recommended for single-VPS deployments)
# Path inside the backend container, mounted via the uploads_data volume.
LOCAL_STORAGE_PATH=/var/data/jansetu/uploads

# Maximum upload size in megabytes (enforced by Nginx + backend)
MAX_UPLOAD_MB=50

# Option B — S3 or S3-compatible (MinIO / Hetzner Object Storage / Backblaze B2)
# Leave all S3 vars blank to use local storage above.
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
# For MinIO or other S3-compatible endpoints:
# S3_ENDPOINT_URL=https://your-minio.example.com

# ── Firebase — Push Notifications ───────────────────────────────────────────
# Place your Firebase Admin SDK JSON at backend/secrets/firebase-admin.json
# and leave the path below as-is (it matches the docker-compose volume mount).
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-admin.json

# Web Push (VAPID) public key — copied from your Firebase project console
REACT_APP_FIREBASE_VAPID_KEY=CHANGE_ME_firebase_vapid_key

# ── Email / SMTP ─────────────────────────────────────────────────────────────
# Used for staff invitation emails, OTP fallback, and system alerts.
# Leave blank to disable email sending.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=CHANGE_ME_smtp_app_password
SMTP_FROM=JANSETU <noreply@yourdomain.com>
SMTP_TLS=true

# ── SMS / OTP ────────────────────────────────────────────────────────────────
# Twilio (or any SMS provider configured in sms_util.py)
# Leave blank to disable SMS OTP (citizens will use email OTP fallback).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# Alternative: MSG91, Fast2SMS, etc. — see sms_util.py for provider config
# SMS_PROVIDER=fast2sms
# SMS_API_KEY=

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=jansetu

# Your production domain (used for CORS and cookie settings)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Uvicorn worker count. Rule of thumb: 2 × CPU cores + 1
WORKERS=3

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Rate Limiting ────────────────────────────────────────────────────────────
# Max failed auth attempts per IP before lockout (in-memory sliding window)
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# ── Super-Admin Bootstrap ────────────────────────────────────────────────────
# Set ONLY on first run to seed the platform super-admin account.
# Remove after the account is created.
# SUPERADMIN_EMAIL=admin@yourdomain.com
# SUPERADMIN_PASSWORD=CHANGE_ME_first_login_password
