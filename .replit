modules = ["nodejs-24", "python-3.12"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "auth-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "web-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "production-runtime"

[[workflows.workflow]]
name = "auth-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "env -u MONGO_URL -u DB_NAME -u JWT_SECRET python -m pytest tests/test_auth_flow.py -q"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "web-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "CI=false pnpm --filter @workspace/jansetu-web run build"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "production-runtime"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/check-production-runtime.py"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[userenv]

[userenv.shared]
DANGEROUSLY_DISABLE_HOST_CHECK = "true"
DB_NAME = "jansetu"
PORT = "5000"
REACT_APP_BACKEND_URL = ""
LOCAL_STORAGE_PATH = "./uploads"
FCM_SERVICE_ACCOUNT_JSON = "/home/runner/workspace/backend/secrets/firebase-admin.json"
REACT_APP_FIREBASE_API_KEY = "AIzaSyDVMKM2iQKAW9AGPomTh_pEFRmJbvq8hlo"
REACT_APP_FIREBASE_APP_ID = "1:1001872155963:web:2f29e7e13ff1021eb2031e"
REACT_APP_FIREBASE_AUTH_DOMAIN = "jansetu-c8b85.firebaseapp.com"
REACT_APP_FIREBASE_MESSAGING_SENDER_ID = "1001872155963"
REACT_APP_FIREBASE_PROJECT_ID = "jansetu-c8b85"

[nix]
channel = "stable-25_05"
packages = ["awsebcli", "c-ares", "cacert", "cargo", "freetype", "glibcLocales", "grpc", "lcms2", "libffi", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "libyaml", "openjpeg", "openssl", "pkg-config", "rustc", "tcl", "tk", "zlib"]
